# Server Configuration
PORT=5000
RUST_LOG=info

# Embedded SQLite Database Configuration
# In production on Render (ephemeral free tier), this path will reset upon container spin-down.
DATABASE_URL=sqlite://data/agentic_commerce.db?mode=rwc

# PayPal Sandbox API Configuration (Required for Live Sandbox Integration)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# PayPal Webhook Configuration (Required for Webhook Signature Verification)
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# Google Gemini AI Configuration (Optional — AI Dispute Investigator)
# If omitted or unconfigured, AgentAudit automatically falls back to its
# deterministic rule-based audit engine without throwing errors.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com

